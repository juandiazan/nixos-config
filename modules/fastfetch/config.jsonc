{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/nixos-config/assets/extra/cryagonal.png",
    "color": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": ""
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 0,
      "left": 0,
      "bottom": 0,
      "right": 4
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted"
    }
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": false,
    "hideCursor": false,
    "separator": ": ",
    "color": {
      "keys": "",
      "title": "",
      "output": "",
      "separator": ""
    },
    "brightColor": true,
    "duration": {
      "abbreviation": false,
      "spaceBeforeUnit": "default"
    },
    "size": {
      "maxPrefix": "YB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default"
    },
    "percent": {
      "type": [
        "num",
        "num-color"
      ],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default",
      "width": 0
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-"
      },
      "border": {
        "left": "[ ",
        "right": " ]",
        "leftElapsed": "",
        "rightElapsed": ""
      },
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97"
      },
      "width": 10
    },
    "fraction": {
      "ndigits": 2,
      "trailingZeros": "default"
    },
    "noBuffer": false,
    "key": {
      "width": 0,
      "type": "string",
      "paddingLeft": 0
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "constants": []
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
    "dsForceDrm": false
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "keyIcon": "",
      "fqdn": false,
      "color": {
        "user": "",
        "at": "",
        "host": ""
      }
    },
    "break",
    { "type": "custom", "format": "\u001b[38;2;8;63;132m==================== OS ====================\u001b[0m" },
    {
      "type": "os",
      "keyColor": "#083f84",
      "keyIcon": ""
    },
    {
      "type": "kernel",
      "keyColor": "#083f84",
      "keyIcon": ""
    },
    {
      "type": "initsystem",
      "keyColor": "#083f84",
      "keyIcon": "󰿄"
    },
    {
      "type": "bootmgr",
      "keyColor": "#083f84",
      "keyIcon": ""
    },
    {
      "type": "uptime",
      "keyColor": "#083f84",
      "keyIcon": ""
    },
    { "type": "custom", "format": "\u001b[38;2;112;75;182m================= Hardware =================\u001b[0m" },
    {
      "type": "host",
      "keyColor": "#704bb6",
      "keyIcon": "󰌢"
    },
    {
      "type": "mouse",
      "keyColor": "#704bb6",
      "keyIcon": "󰍽"
    },
    {
      "type": "keyboard",
      "keyColor": "#704bb6",
      "keyIcon": ""
    },
    {
      "type": "battery",
      "keyColor": "#704bb6",
      "keyIcon": "",
      "temp": false,
      "percent": {
        "green": 50,
        "yellow": 20,
        "type": 0
      }
    },
    {
      "type": "poweradapter",
      "keyColor": "#704bb6",
      "keyIcon": "󰚥"
    },
    {
      "type": "wifi",
      "keyColor": "#704bb6",
      "keyIcon": "",
      "percent": {
        "green": 75,
        "yellow": 50,
        "type": 0
      }
    },
    {
      "type": "bluetooth",
      "keyColor": "#704bb6",
      "keyIcon": "",
      "showDisconnected": false,
      "percent": {
        "green": 50,
        "yellow": 20,
        "type": 0
      }
    },
    { "type": "custom", "format": "\u001b[38;2;5;143;143m================== Specs ===================\u001b[0m" },
    {
      "type": "cpu",
      "keyColor": "#058f8f",
      "keyIcon": "",
      "temp": false,
      "showPeCoreCount": true,
      "tempSensor": ""
    },
    {
      "type": "gpu",
      "keyColor": "#058f8f",
      "keyIcon": "󰾲",
      "driverSpecific": false,
      "detectionMethod": "pci",
      "temp": false,
      "hideType": "none",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "physicalmemory",
      "keyColor": "#058f8f",
      "keyIcon": "󰑭",
      "showEmptySlots": false
    },
    {
      "type": "memory",
      "keyColor": "#058f8f",
      "keyIcon": "",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "disk",
      "keyColor": "#058f8f",
      "keyIcon": "",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": true,
      "showUnknown": false,
      "folders": "",
      "hideFolders": "/efi:/boot:/boot/*",
      "hideFS": "",
      "useAvailable": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    { "type": "custom", "format": "\u001b[38;2;85;212;178m================= Desktop ==================\u001b[0m" },
    {
      "type": "display",
      "keyColor": "#55d4b2",
      "keyIcon": "󰍹",
      "compactType": "none",
      "preciseRefreshRate": false,
      "order": null
    },
    {
      "type": "wm",
      "keyColor": "#55d4b2",
      "keyIcon": "",
      "detectPlugin": true
    },
    {
      "type": "lm",
      "keyColor": "#55d4b2",
      "keyIcon": ""
    },
    {
      "type": "font",
      "keyColor": "#55d4b2",
      "keyIcon": ""
    },
    {
      "type": "icons",
      "keyColor": "#55d4b2",
      "keyIcon": ""
    },
    {
      "type": "cursor",
      "keyColor": "#55d4b2",
      "keyIcon": "󰆿"
    },
    { "type": "custom", "format": "\u001b[38;2;225;71;109m================= Terminal =================\u001b[0m" },
    {
      "type": "shell",
      "keyColor": "#e1476d",
      "keyIcon": ""
    },
    {
      "type": "terminal",
      "keyColor": "#e1476d",
      "keyIcon": ""
    },
    {
      "type": "terminalfont",
      "keyColor": "#e1476d",
      "keyIcon": ""
    },
    {
      "type": "editor",
      "keyColor": "#e1476d",
      "keyIcon": "󱞎"
    },
    { "type": "custom", "format": "\u001b[38;2;197;5;42m================== Others ==================\u001b[0m" },
    {
      "type": "datetime",
      "keyColor": "#c5052a",
      "keyIcon": ""
    },
    {
      "type": "player",
      "keyColor": "#c5052a",
      "keyIcon": "󰥠"
    },
    {
      "type": "media",
      "keyColor": "#c5052a",
      "keyIcon": "",
      "percent": {
        "green": 100,
        "yellow": 100,
        "type": 0
      }
    },
    {
      "type": "weather",
      "keyColor": "#c5052a",
      "keyIcon": "󰖙",
      "location": "",
      "outputFormat": "%t+-+%C+(%l)",
      "timeout": 0
    },
    {
      "type": "version",
      "keyColor": "#c5052a",
      "keyIcon": ""
    },
    "break",
    {
      "type": "colors",
      "key": " ",
      "keyIcon": "",
      "symbol": "block",
      "paddingLeft": 0,
      "block": {
        "width": 3,
        "range": [
          0,
          15
        ]
      },
      "brightness": "default"
    }
  ]
}
